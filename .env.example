# ============================================================
# NESL Social Media Agent — Environment Configuration
# ============================================================

# Anthropic Claude API Key (required)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Instagram Credentials (required for auto-posting)
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password

# Auto-post settings
# Set to "true" to automatically post to Instagram without confirmation
AUTO_POST=false

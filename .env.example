# ============================================================
# NESL Social Media Agent — Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Anthropic Claude API Key (required)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Instagram Credentials (required for auto-posting)
INSTAGRAM_USERNAME=nesportslab
INSTAGRAM_PASSWORD=your_instagram_password_here

# Auto-post settings
# Set to "true" to automatically post to Instagram without confirmation
AUTO_POST=false
